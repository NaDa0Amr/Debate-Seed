# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=ragdb
PGUSER=postgres
PGPASSWORD=change_me

# Embedding model (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DIM=384

# Cross-encoder reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_REVISION=main

# IVFFlat tuning. The defaults scan every list for reproducible local results.
IVFFLAT_MAX_LISTS=100
IVFFLAT_PROBES=100

# Increment these when cleaning/chunk semantics or the pipeline contract changes.
PREPROCESSING_VERSION=clean-v2-chunk-v3-context
PIPELINE_VERSION=rag-pipeline-2026.09.01-context-v1
